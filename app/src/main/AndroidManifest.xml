<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="org.librefit.companion" />
        <!-- Health Connect is a separate app on Android 13 and lower -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Lets the rest timer show as a Live Update (status bar chip, Samsung Now Bar) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Keeps the rest timer running on time while the screen is off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Writes completed workouts to Health Connect, only when turned on in settings -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".MainApplication"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibreFit"
        android:windowSoftInputMode="adjustResize"
        tools:targetApi="tiramisu">
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LibreFit.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the system Settings app (App Info page) open the in-app Settings
                 screen via Intent.ACTION_APPLICATION_PREFERENCES. See nav/DeepLinks.kt. -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.PrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:theme="@style/Theme.LibreFit.SplashScreen"
            android:exported="true">
            <!-- VIEW_PERMISSION_USAGE shows a selectable information icon on
                 LibreFit permission's page in system settings.
                 VIEW_PERMISSION_USAGE_FOR_PERIOD shows a selectable information
                 icon on the Privacy Dashboard screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE_FOR_PERIOD" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Health Connect shows the privacy notice as the rationale of its permissions, and does
             not offer them without it. On Android 14+ it is opened through the permission usage
             action with the health permissions category. -->
        <activity-alias
            android:name=".activities.HealthPermissionsUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".activities.PrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- On Android 13 and lower the Health Connect app opens the rationale itself -->
        <activity-alias
            android:name=".activities.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:targetActivity=".activities.PrivacyActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".activities.ErrorActivity"
            android:exported="false"
            android:theme="@style/Theme.LibreFit.SplashScreen"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:process=":error_process">
        </activity>

        <!-- Saves persistently the language locale in Android 12 and below-->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name=".services.WorkoutService"
            android:foregroundServiceType="dataSync"
            android:exported="false">
        </service>

    </application>
</manifest>