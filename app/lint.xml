<!-- The KSP output is added to the source sets in build.gradle.kts, so lint takes the code Room
     generates for the source of the app and checkGeneratedSources does not leave it out. Lint
     flags it with RestrictedApi errors, since Room's own code calls Room's internal API. -->
<lint>
    <issue id="all">
        <ignore path="build/generated/**" />
        <ignore regexp=".*[/\\]build[/\\]generated[/\\].*" />
    </issue>
</lint>
